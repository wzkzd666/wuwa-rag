from wuwa_rag.retrieval.bm25 import BM25Index, tokenize, add_terms

add_terms(['共鸣解放', '卡卡罗', '三阶突破'])   # 模拟术语词典

docs = [
    '卡卡罗 共鸣解放 技能伤害 300%',
    '卡卡罗 三阶突破 材料 特制镣环',
    '折枝 共鸣技能 治疗量',
]
ids = ['a', 'b', 'c']
idx = BM25Index(ids, [tokenize(d) for d in docs], terms=['共鸣解放','卡卡罗','三阶突破'])

p = idx.save()
print('落盘:', p)

idx2 = BM25Index.load()
print('查「卡卡罗突破材料」:', [(h.chunk_id, round(h.score,2)) for h in idx2.search('卡卡罗突破材料', topk=3)])
print('查「共鸣解放伤害」:', [(h.chunk_id, round(h.score,2)) for h in idx2.search('共鸣解放伤害', topk=3)])